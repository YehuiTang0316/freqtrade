{
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 3,
    "stake_currency": "USDT",
    "stake_amount": 30,
    "tradable_balance_ratio": 0.99,
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "BNB/USDT:USDT",
            "XRP/USDT:USDT",
            "ADA/USDT:USDT",
            "DOGE/USDT:USDT",
            "AVAX/USDT:USDT",
            "LINK/USDT:USDT",
            "DOT/USDT:USDT"
        ],
        "pair_blacklist": [],
        "ccxt_config": {
            "aiohttp_proxy": "http://host.docker.internal:8118",
            "proxies": {
                "http": "http://host.docker.internal:8118",
                "https": "http://host.docker.internal:8118"
            }
        }
    },
    "pairlists": [
        {"method": "StaticPairList"}
    ],
    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },
    "freqai": {
        "enabled": true,
        "purge_old_models": 2,
        "train_period_days": 10,
        "backtest_period_days": 2,
        "live_retrain_hours": 4,
        "identifier": "rawpulse-lgbm-v1",
        "feature_parameters": {
            "include_timeframes": ["5m", "15m", "1h"],
            "include_corr_pairlist": [
                "BTC/USDT:USDT",
                "ETH/USDT:USDT"
            ],
            "label_period_candles": 6,
            "include_shifted_candles": 2,
            "DI_threshold": 0.9,
            "weight_factor": 0.9,
            "principal_component_analysis": false,
            "use_SVM_to_remove_outliers": true,
            "indicator_periods_candles": [6, 12, 24],
            "plot_feature_importances": 0
        },
        "data_split_parameters": {
            "test_size": 0.25,
            "random_state": 42
        },
        "model_training_parameters": {
            "n_estimators": 800,
            "learning_rate": 0.02,
            "max_depth": 6,
            "num_leaves": 48,
            "min_child_samples": 30,
            "subsample": 0.75,
            "colsample_bytree": 0.75,
            "reg_alpha": 0.3,
            "reg_lambda": 0.3,
            "class_weight": "balanced",
            "verbosity": -1
        }
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "jwt_secret_key": "freqtrade-local-dev-key-change-me",
        "CORS_origins": [],
        "username": "freqtrader",
        "password": "freqtrader"
    },
    "bot_name": "freqtrade-rawpulse",
    "initial_state": "running",
    "internals": {
        "process_throttle_secs": 5
    }
}
